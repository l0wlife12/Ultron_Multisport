# Configuration ULTRON MULTISPORTS - Fichier Sécurisé
# ⚠️ NE PAS PARTAGER CE FICHIER! GARDER PRIVÉ!
# ⚠️ NE PAS COMMITER EN GIT!
# Sur Railway: configurer ces valeurs dans Settings → Variables

# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Chat ID du canal principal (obtenu via @userinfobot)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Chat ID du canal VIP (laisser vide si pas de canal VIP)
TELEGRAM_CHAT_ID_VIP=YOUR_VIP_CHAT_ID_HERE

# Clé API pour les cotes en temps réel (https://the-odds-api.com)
ODDS_API_KEY=YOUR_ODDS_API_KEY_HERE
